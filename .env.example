# CareFlow runs offline-first and automatically uses Supabase when connectivity is available.
# Set to "offline" to force local-only operation or "supabase" for controlled online-only deployments.
VITE_CAREFLOW_DATA_MODE=hybrid

# Bredas Insurance / Claims Tracker Supabase project.
VITE_SUPABASE_PROJECT_ID=jajfdgknctzqypdtvmxo
VITE_SUPABASE_URL=https://jajfdgknctzqypdtvmxo.supabase.co

# Copy the project's PUBLISHABLE key from Supabase Dashboard > Settings > API Keys.
# Do not place a secret/service-role key in this variable.
VITE_SUPABASE_PUBLISHABLE_KEY=
