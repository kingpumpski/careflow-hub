# CareFlow defaults to offline IndexedDB mode for departmental operations.
# Set to "supabase" only when an authenticated online deployment is intentionally configured.
VITE_CAREFLOW_DATA_MODE=offline

# Required only for online Supabase mode.
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
